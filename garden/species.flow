    set_species_col(12, 98, 70, 60, 120, 82, 70, 64, 140, 76)
    set_species_col(13, 74, 100, 56, 90, 130, 62, 70, 140, 70)
    set_species_col(14, 82, 124, 70, 100, 150, 84, 88, 150, 84)
    set_species_col(SP_OAK, 96, 72, 52, 84, 70, 52, 74, 136, 52)
    set_species_col(SP_PINE, 92, 66, 46, 74, 60, 42, 52, 112, 62)
    set_species_col(SP_BIRCH, 226, 222, 210, 150, 140, 122, 134, 184, 72)
    set_species_col(SP_WILLOW, 112, 98, 66, 124, 140, 74, 146, 186, 92)
}

function pack3(r: i32, g: i32, b: i32) -> i32 {
    let mut rr: i32 = r
    let mut gg: i32 = g
    let mut bb: i32 = b
    if rr < 0 { rr = 0 }
    if gg < 0 { gg = 0 }
    if bb < 0 { bb = 0 }
    if rr > 255 { rr = 255 }
    if gg > 255 { gg = 255 }
    if bb > 255 { bb = 255 }
    return (rr << 16) | (gg << 8) | bb
}

# A flower colour drawn from each species' palette.
function pick_flower(sp: i32) -> i32 {
    let k: i32 = rng_below(4)
    if sp >= N_BASE_SPECIES {
        # A generated species varies its flower around one colour.
        let c: i32 = g_flower[sp]
        let d: i32 = (k - 1) * 18
        return pack3(col_r(c) + d, col_g(c) - d / 2, col_b(c) + d / 3)
    }
    if sp == 6 {
        if k == 0 { return 0xF4F0F8 }
        if k == 1 { return 0xC9A0E8 }
        if k == 2 { return 0xF2A6C8 }
        return 0x9DB4F5
    }
    if sp == 7 {
        if k == 0 { return 0xE8343C }
        if k == 1 { return 0xF5C431 }
        if k == 2 { return 0xF07A2A }
        return 0xF086B4
    }
    if sp == 13 {
        if k == 0 { return 0xD2203A }
        if k == 1 { return 0xF07C98 }
        if k == 2 { return 0xF6E0C8 }
        return 0xB01848
    }
    if sp == 14 {
        if k == 0 { return 0xD860B0 }
        if k == 1 { return 0xB070D8 }
        if k == 2 { return 0xF0B0D8 }
        return 0xF2F0F4
    }
    if sp == 8 { return 0x9878D8 }
    if sp == 9 { return 0xECEEE8 }
    if sp == 10 { return 0xF6C622 }
    if sp == 11 { return 0x6A4428 }
    if sp == 12 {
        if k < 2 { return 0xD02838 }
        return 0x3A3A9A
    }
    return 0xF0F0F0
}
