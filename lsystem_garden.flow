# L-SYSTEM GARDEN: nineteen rewriting grammars living out their lives on a
# generated map, or in two flat beds.
#
# MODEL (Lindenmayer, 1968; Prusinkiewicz and Lindenmayer, 1990)
#   Every plant is a string over a small alphabet, rewritten in parallel a
#   fixed number of times from its species' axiom. Each species is nothing
#   more than an axiom, a few productions, a turn angle and a generation
#   count. Several productions for one symbol make the grammar stochastic,
#   so two plants of one species are never the same.
#
#     F         draw a segment forward
#     + -       turn by the species angle (with a small per-symbol jitter)
#     & ^       pitch down and up (3D)       / \   roll (3D)
#     [ ]       push and pop the turtle state; a closing bracket is a tip
#     !         thin the branches that follow
#     L         a leaf, drawn where the turtle stands
#     K         a flower on the stem
#     A         an apex; whatever is left after the last generation blooms
#     X B C S   growth symbols that are rewritten and never drawn
#
# GROWTH IN TIME
#   Each string is derived once. As a plant grows the turtle reads a longer
#   prefix of it, so it extends in the order its grammar produced.
#
# LIFE
#   A year is 96 days. Plants germinate, grow, flower in their season, set
#   seed, wither and die. Seeds carry their parent's genes (turn angle, leaf
#   length, height, flower colour) with small mutations, and land where
#   their species can live. Taller plants shade their neighbours but make
#   fewer seeds, so the population's genes drift. See garden/life.flow.
#
# TWO VIEWS
#   3D     a 512 m map generated from a seed: hills, lakes and a mountain
#          rim, with each species where its niche is. Walk it in first person.
#   FLAT   eighteen plants in two beds, drawn by a 2D turtle in the style
#          of examples/morphogenesis/lsystem_plant.flow.
#
# KEYS AND MOUSE
#   3 walk the map    4 orbit a planet    2 the flat beds    Tab switch
#   N map or planet size (256, 512, 1024 m around)    L sunlight or even light
#   - = slow down and speed up time (x0.25 to x128)    P pause
#   R new world seed (3D) or new beds (flat)    G wind    I species table
#   K weather (automatic, dry, showers, rain, storm)    J day length
#   Q E choose a seed, then click the ground (3D) or a bed (flat) to plant
#   3D: W A S D walk, arrows or mouse drag look, M or Shift run, F rise to
#       the treetops and then high above the map, look at a plant to read
#       its life, genes and grammar
#   Esc quit
#
# The world seed comes from the clock, or from LSYS_SEED if it is set.
#
# Run: ./flow gfx lsystem_garden.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"
import "stdlib/render3d.flow"
import "./garden/common.flow"
import "./garden/species.flow"
import "./garden/derive.flow"
import "./garden/hud.flow"
import "./garden/calendar.flow"
import "./garden/noise.flow"
import "./garden/terrain.flow"
import "./garden/models.flow"
import "./garden/life.flow"
import "./garden/genus.flow"
import "./garden/sky.flow"
import "./garden/control.flow"
import "./garden/flat.flow"
import "./garden/view.flow"
import "./garden/walk.flow"
import "./garden/orbit.flow"

const MAX_FRAMES: i32 = 10000000
const KEY_G: i32 = 5
const KEY_I: i32 = 34
const KEY_F: i32 = 3
const KEY_K: i32 = 40
const KEY_J: i32 = 38
const KEY_N: i32 = 45
const KEY_4: i32 = 21
const KEY_L: i32 = 37
const KEY_MINUS: i32 = 27
const KEY_EQUALS: i32 = 24

const VIEW_FLAT: i32 = 0
const VIEW_WALK: i32 = 1
const VIEW_PLANET: i32 = 2

# Edge detection for keys: true only on the frame a key goes down.
let mut held: ptr<i32> = null

function pressed(g: Gfx, key: i32) -> bool {
    let down: bool = gfx_key_down(g, key)
    let was: bool = held[key] != 0
    if down { held[key] = 1 } else { held[key] = 0 }
    return down and !was
}

function cycle_seed(seed: i32, dir: i32, n: i32) -> i32 {
    let mut s: i32 = seed + dir
    if s >= n { s = -1 }
    if s < -1 { s = n - 1 }
    return s
}

# K: automatic weather, then dry, showers, rain and storm.
function cycle_weather() -> void {
    if rain_auto {
        rain_auto = false
        rain_target = 0.0
        return
    }
    if rain_target < 0.1 {
        rain_target = 0.3
        return
    }
    if rain_target < 0.5 {
        rain_target = 0.65
        return
    }
    if rain_target < 0.8 {
        rain_target = 1.0
        return
    }
    rain_auto = true
    weather_timer = 0.0
}

# J: a day of 150 s, 40 s, 600 s, or the hour held still.
function cycle_day_length() -> void {
    if day_len == 150.0 {
        day_len = 40.0
        return
    }
    if day_len == 40.0 {
        day_len = 600.0
        return
    }
    if day_len == 600.0 {
        day_len = 0.0
        return
    }
    day_len = 150.0
}

# Generate the map, its plants and the walker's start from world_seed.
function new_world() -> void {
    rng_state = world_seed * 2654435761 + 12345
    set_map_size(map_size)
    generate_species()
    terrain_generate()
    models_reset()
    build_grass_models()
    populate()
    if world_kind == WORLD_PLANET {
        orbit_reset()
    } else {
        walk_reset()
    }
}

function seed_from_env() -> u32 {
    let e: ptr<u8> = getenv("LSYS_SEED")
    if e != null {
        let v: i32 = atoi(e)
        if v > 0 { return v as u32 }
    }
    let t: i64 = time(null)
    return ((t % 900000) + 100000) as u32
}

# LSYS_REPORT=<years>: run the world without a window and print, each
# year, every species' living count, seedlings born that year, deepest
# generation and mean height gene. The evidence that plants reproduce.
function report(years: i32) -> i32 {
    print("seed ")
    print(world_seed as i32)
    println("")
    let last: ptr<i32> = alloc_i32(MAX_SPECIES)
    for sp in 0 to N_SPECIES { last[sp] = 0 }
    for y in 0 to years {
        let mut d: i32 = 0
        while d < 96 {
            sim_day = sim_day + 1.0
            life_step(1.0)
            d = d + 1
        }
        print("year ")
        print(y + 1)
        print("  plants ")
        print(plants_alive())
        println("")
        for sp in 0 to N_SPECIES {
            let mut live: i32 = 0
            let mut gmax: i32 = 0
            let mut sh: f64 = 0.0
            for k in 0 to n_plants {
                if in_used[k] == 1 and in_sp[k] == sp and in_stage[k] != ST_SEED {
                    live = live + 1
                    sh = sh + (in_gh[k] as f64)
                    if in_gen[k] > gmax { gmax = in_gen[k] }
                }
            }
            if live > 0 or sp_births[sp] > 0 {
                let mut mh: i32 = 0
                if live > 0 { mh = (sh / (live as f64) * 100.0) as i32 }
                print("  ")
                print(species_name(sp))
                print("  live ")
                print(live)
                print("  born ")
                print(sp_births[sp] - last[sp])
                print("  gen ")
                print(gmax)
                print("  height% ")
                print(mh)
                println("")
            }
            last[sp] = sp_births[sp]
        }
    }
    return 0
}

# LSYS_PROFILE=1 prints each frame's CPU time and model builds to stdout.
let mut prof_on: bool = false
# clock() is declared by stdlib/render3d.flow.
let mut prof_last: i64 = 0

function clock_ms_probe(now: f64) -> i32 {
    let c: i64 = clock() as i64
    print("frame_ms ")
    print(((c - prof_last) / 1000) as i32)
    print(" day ")
    print(doy() as i32)
    print(" built ")
    print(models_built)
    print(" models ")
    print(models_in_use())
    print(" nodes ")
    print(n_nodes)
    print(" segs ")
    print(n_segs)
    print(" orns ")
    print(n_orns)
    print(" births ")
    print(births)
    println("")
    prof_last = c
    return 0
}

function main() -> i32 {
    held = alloc_i32(128)
    for k in 0 to 128 { held[k] = 0 }

    define_species()
    derive_init()
    define_life()
    flat_init()
    terrain_alloc()
    models_alloc()
    life_alloc()
    walk_alloc()
    if !view_init() { return 1 }
    world_seed = seed_from_env()
    let ms: ptr<u8> = getenv("LSYS_MAP")
    if ms != null {
        let v: i32 = atoi(ms)
        if v == 256 or v == 512 or v == 1024 { map_size = v as f64 }
    }
    if getenv("LSYS_PLANET") != null { world_kind = WORLD_PLANET }
    new_world()
    prof_on = getenv("LSYS_PROFILE") != null
    let rep: ptr<u8> = getenv("LSYS_REPORT")
    if rep != null { return report(atoi(rep)) }

    let g: Gfx = gfx_open(WIN_W, WIN_H, "L-system garden - Flow morphogenesis")

    let mut mode: i32 = VIEW_WALK
    if world_kind == WORLD_PLANET { mode = VIEW_PLANET }
    let mut paused: bool = false
    let mut seed_sp: i32 = -1
    let mut click_held: bool = false
    let mut show_info: bool = false
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        if pressed(g, KEY_2) { mode = VIEW_FLAT }
        # 3 walks a map and 4 orbits a planet: switching grows the other kind
        # of world from the same seed.
        if pressed(g, KEY_3) {
            if world_kind == WORLD_PLANET {
                world_kind = WORLD_MAP
                new_world()
            }
            mode = VIEW_WALK
        }
        if pressed(g, KEY_4) {
            if world_kind != WORLD_PLANET {
                world_kind = WORLD_PLANET
                new_world()
            }
            mode = VIEW_PLANET
        }
        if pressed(g, KEY_TAB) {
            if mode == VIEW_FLAT {
                mode = VIEW_WALK
                if world_kind == WORLD_PLANET { mode = VIEW_PLANET }
            } else {
                mode = VIEW_FLAT
            }
        }
        if pressed(g, KEY_N) and mode != VIEW_FLAT {
            map_size = map_size * 2.0
            if map_size > 1024.0 { map_size = 256.0 }
            new_world()
        }
        # The page's world controls.
        if ctl_map_size > 0.0 {
            map_size = ctl_map_size
            ctl_map_size = 0.0
        }
        if ctl_world >= 0 {
            world_kind = ctl_world
            ctl_world = -1
        }
        if ctl_regen >= 0.0 {
            if ctl_regen > 0.0 { world_seed = ctl_regen as u32 }
            ctl_regen = -1.0
            new_world()
            mode = VIEW_WALK
            if world_kind == WORLD_PLANET { mode = VIEW_PLANET }
        }
        if pressed(g, KEY_P) { paused = !paused }
        if pressed(g, KEY_G) { wind_level = (wind_level + 1) % 4 }
        if pressed(g, KEY_I) { show_info = !show_info }
        if pressed(g, KEY_F) and mode == VIEW_WALK { w_lift = (w_lift + 1) % 3 }
        if pressed(g, KEY_MINUS) and time_level > 0 { time_level = time_level - 1 }
        if pressed(g, KEY_EQUALS) and time_level < MAX_TIME_LEVEL { time_level = time_level + 1 }
        if pressed(g, KEY_K) { cycle_weather() }
        if pressed(g, KEY_J) { cycle_day_length() }
        if pressed(g, KEY_L) { sun_light = !sun_light }
        if pressed(g, KEY_R) {
            if mode == VIEW_FLAT {
                flat_new_garden()
            } else {
                world_seed = ((rng_next() >> 4) % 900000 + 100000) as u32
                new_world()
            }
        }
        let mut dt: f64 = 0.0
        if !paused {
            dt = time_scale() / 60.0
            sim_day = sim_day + dt
            wind_time = wind_time + 1.0 / 60.0
            sky_step(1.0 / 60.0, dt)
        }

        let mut nseed: i32 = N_SPECIES
        if mode == VIEW_FLAT { nseed = N_FLAT_SPECIES }
        if seed_sp >= nseed { seed_sp = -1 }
        if pressed(g, KEY_E) { seed_sp = cycle_seed(seed_sp, 1, nseed) }
        if pressed(g, KEY_Q) { seed_sp = cycle_seed(seed_sp, -1, nseed) }

        if mode == VIEW_PLANET {
            orbit_update(g, seed_sp)
            let steps: i32 = (dt / 1.5) as i32 + 1
            for st in 0 to steps { life_step(dt / (steps as f64)) }
            orbit_render()
            r3d_tick()
            view_present(g)
            orbit_hud(g, seed_sp, paused, show_info)
        } elif mode == VIEW_FLAT {
            if pressed(g, KEY_RIGHT) { seed_sp = cycle_seed(seed_sp, 1, nseed) }
            if pressed(g, KEY_LEFT) { seed_sp = cycle_seed(seed_sp, -1, nseed) }
            let m: Mouse = gfx_mouse(g)
            let clicked: bool = m.left != 0 and !click_held
            click_held = m.left != 0
            flat_pointer(m.x, m.y, m.inside != 0, clicked, seed_sp)
            flat_step(dt)
            flat_draw(g, seed_sp, paused)
        } else {
            walk_update(g, seed_sp)
            # Fast time runs the life step in slices of at most a day and a
            # half, so seeding, germination and death stay in step.
            let steps: i32 = (dt / 1.5) as i32 + 1
            for st in 0 to steps { life_step(dt / (steps as f64)) }
            walk_camera()
            view_render()
            r3d_tick()
            view_present(g)
            walk_draw_hud(g, seed_sp, paused, show_info)
        }

        if prof_on {
            let now: f64 = gfx_time_ms(g)
            let _c: i32 = clock_ms_probe(now)
        }
        gfx_present(g)
        gfx_wait_frame(g, 60)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
